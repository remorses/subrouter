{
  "name": "@subrouter/pi",
  "version": "0.1.0",
  "type": "module",
  "description": "Pi extension that cycles through personal AI subscriptions with native provider streams.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/remorses/subrouter.git",
    "directory": "pi"
  },
  "homepage": "https://github.com/remorses/subrouter",
  "bugs": "https://github.com/remorses/subrouter/issues",
  "keywords": [
    "pi-package",
    "pi",
    "ai",
    "router",
    "subscriptions"
  ],
  "files": [
    "src",
    "dist"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./src": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./src/*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc",
    "test": "vitest run",
    "prepublishOnly": "rimraf dist \"*.tsbuildinfo\" && pnpm build"
  },
  "dependencies": {
    "@subrouter/cli": "workspace:^"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.3",
    "@earendil-works/pi-coding-agent": "0.84.3",
    "@types/node": "^24.13.3",
    "@types/ws": "8.18.1",
    "rimraf": "^6.1.3",
    "ws": "^8.21.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "^0.84.3",
    "@earendil-works/pi-coding-agent": "^0.84.3"
  }
}
